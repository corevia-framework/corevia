<?php $t=$aiUi->text(...);$a=$ui->text(...); ?>
<!doctype html><html lang="<?= $e($ui->locale) ?>" dir="<?= $e($ui->direction()) ?>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><?= $e($t('AI workspace')) ?> | Corevia</title><link rel="stylesheet" href="/assets/auth.css"><link rel="stylesheet" href="/assets/ai.css"><script type="module" src="/assets/auth-account.js"></script><script type="module" src="/assets/ai.js"></script></head>
<body class="cv-auth cv-ai"><div id="corevia-ui" hidden data-messages="<?= $e(json_encode($ui->messages(),JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE)) ?>"></div><div data-ai-ui hidden data-enabled="<?= $enabled?'true':'false' ?>" data-messages="<?= $e(json_encode($aiUi->messages(),JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE)) ?>"></div>
<a class="auth-skip" href="#auth-main"><?= $e($a('Skip to content')) ?></a><header class="auth-topbar"><a class="auth-brand" href="/"><span aria-hidden="true">C</span>corevia</a><div class="auth-preferences"><label><?= $e($a('Language')) ?><select data-auth-locale aria-label="<?= $e($a('Language')) ?>"><?php foreach(['en'=>'English','ur'=>'اردو','ar'=>'العربية'] as $code=>$name): ?><option value="<?= $e($code) ?>" <?= $ui->locale===$code?'selected':'' ?>><?= $e($name) ?></option><?php endforeach ?></select></label><button type="button" data-auth-theme><?= $e($a('Theme: system')) ?></button></div></header>
<main id="auth-main" tabindex="-1"><div class="ai-heading"><div><p class="auth-eyebrow"><?= $e($t('AI workspace')) ?></p><h1><?= $e($t('A little room for big ideas.')) ?></h1><p class="auth-muted"><?= $e($t('Ask a question, explore an idea, or work through a draft.')) ?></p></div><a href="/dashboard"><?= $e($t('Dashboard')) ?> <span aria-hidden="true">↗</span></a></div>
<div class="ai-layout"><section class="auth-surface ai-composer" aria-labelledby="ai-message-heading"><h2 id="ai-message-heading"><?= $e($t('Create a message')) ?></h2><form method="post" action="/ai/chat"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label class="ai-label" for="ai-message"><?= $e($t('Your message')) ?></label><textarea id="ai-message" name="message" maxlength="4096" required rows="8" placeholder="<?= $e($t('Write your message here…')) ?>" aria-describedby="ai-privacy" <?= !$enabled?'disabled':'' ?>></textarea><p id="ai-privacy" class="auth-muted"><?= $e($t('Messages are sent to the model configured by this application. Avoid sharing secrets.')) ?></p><div class="ai-actions"><button type="submit" <?= !$enabled?'disabled':'' ?>><?= $e($t('Send')) ?></button><button type="button" class="ai-secondary" data-cancel disabled><?= $e($t('Cancel')) ?></button><button type="button" class="ai-secondary" data-clear><?= $e($t('Clear')) ?></button></div></form><p class="ai-status" role="status" aria-live="polite" aria-atomic="true" data-status><?= $e($t($enabled?'Ready when you are.':'AI is not configured for this application yet.')) ?></p></section>
<section class="auth-surface ai-response" aria-labelledby="ai-response-heading"><div class="ai-response-top"><h2 id="ai-response-heading"><?= $e($t('Response')) ?></h2><span class="ai-badge" data-response-state hidden></span></div><div class="ai-empty" data-empty><span class="ai-spark" aria-hidden="true">&#10035;</span><h3><?= $e($t('Your next idea starts here.')) ?></h3><p><?= $e($t('Send a message to start. Responses appear here as they arrive.')) ?></p></div><pre data-output tabindex="0" aria-label="<?= $e($t('Response')) ?>" hidden></pre></section></div><p class="ai-footnote auth-muted"><?= $e($t('This page keeps no conversation history after you leave.')) ?></p></main></body></html>
