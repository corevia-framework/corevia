    'mongo'=>['uri'=>getenv('AUTH_MONGODB_URI')?:'mongodb://127.0.0.1:27017','database'=>getenv('AUTH_MONGODB_DATABASE')?:'corevia','collection'=>'cv_auth','scope'=>getenv('AUTH_SCOPE')?:'main'],
    'roles'=>['admin'=>['admin.access'],'editor'=>['documents.read','documents.update']],
