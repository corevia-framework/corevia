<?php $ui??=new \Corevia\Auth\AuthPresentation();$t=$ui->text(...); ?>
<!doctype html><html lang="<?= $e($ui->locale) ?>" dir="<?= $e($ui->direction()) ?>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title><?= $e($title) ?> | Corevia</title><link rel="stylesheet" href="/assets/auth.css"><script type="module" src="/assets/auth-account.js"></script><?php if($reactShell??false): ?><script type="module" src="/assets/auth.js"></script><?php endif ?></head><body class="cv-auth">
<div id="corevia-ui" hidden data-messages="<?= $e(json_encode($ui->messages(),JSON_THROW_ON_ERROR|JSON_UNESCAPED_UNICODE)) ?>"></div>
<a class="auth-skip" href="#auth-main"><?= $e($t('Skip to content')) ?></a><header class="auth-topbar"><a href="/" class="auth-brand"><span aria-hidden="true">C</span>corevia</a><div class="auth-preferences"><label><?= $e($t('Language')) ?><select data-auth-locale aria-label="<?= $e($t('Language')) ?>"><?php foreach(['en'=>'English','ur'=>'اردو','ar'=>'العربية'] as $code=>$name): ?><option value="<?= $e($code) ?>" <?= $ui->locale===$code?'selected':'' ?>><?= $e($name) ?></option><?php endforeach ?></select></label><button type="button" data-auth-theme aria-label="<?= $e($t('Theme: system').'. '.$t('Change color theme')) ?>"><?= $e($t('Theme: system')) ?></button></div></header>
<main id="auth-main" tabindex="-1">
