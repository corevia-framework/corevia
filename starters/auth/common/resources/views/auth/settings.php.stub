<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Account settings · Corevia</title><link rel="stylesheet" href="/assets/auth.css"><script type="module" src="/assets/auth-account.js"></script></head>
<?php $boot=$stack==='bootstrap';$field=$boot?'form-control mb-3':'mb-4 block w-full rounded-lg border border-slate-700 bg-slate-950 p-3';$button=$boot?'btn btn-primary':'rounded-lg bg-cyan-400 p-3 text-slate-950'; ?>
<body class="<?= $boot?'bg-light':'bg-slate-950 text-slate-100' ?>"><main class="<?= $boot?'container py-5':'mx-auto max-w-2xl px-6 py-10' ?>"><h1>Account settings</h1><p><a href="/dashboard">Back to dashboard</a> · <?= $e($user['email']) ?></p>
<p role="status" data-account-notice></p><pre data-account-output class="text-break whitespace-pre-wrap break-words"></pre>
<?php foreach(['profile'=>'Name','email'=>'Email','password'=>'Password'] as $operation=>$title): ?>
<section class="<?= $boot?'card p-4 my-4':'my-8 rounded-lg border border-slate-700 p-5' ?>"><h2>Change <?= $e(strtolower($title)) ?></h2><form method="post" action="/auth/account/<?= $e($operation) ?>" data-account-action="/auth/account/<?= $e($operation) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>">
<?php $name=match($operation){'profile'=>'name','email'=>'email',default=>'password'}; ?><label><?= $e($title) ?><input class="<?= $e($field) ?>" name="<?= $e($name) ?>" type="<?= $operation==='email'?'email':($operation==='password'?'password':'text') ?>" <?= $operation==='password'?'autocomplete="new-password" minlength="12"':'maxlength="254"' ?> required></label>
<?php if($operation==='password'): ?><label>Confirm new password<input class="<?= $e($field) ?>" type="password" name="password_confirmation" autocomplete="new-password" required></label><?php endif ?>
<label>Current password<input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label>Authenticator or recovery code<input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code" maxlength="32"></label><button class="<?= $e($button) ?>">Save <?= $e(strtolower($title)) ?></button></form></section>
<?php endforeach ?>
<section><h2>Authenticator</h2><p><?= $mfaAvailable?($mfaEnabled?'Enabled. Each code can be used once.':'Not enabled. Setup needs an authenticator app.'):'Authenticator setup is currently unavailable. Contact your administrator.' ?></p>
<?php if($mfaAvailable): foreach(['setup'=>'Start authenticator setup','enable'=>'Confirm authenticator setup','disable'=>'Disable authenticator'] as $operation=>$label): ?><form method="post" action="/auth/mfa/<?= $e($operation) ?>" data-account-action="/auth/mfa/<?= $e($operation) ?>" class="<?= $boot?'my-3':'my-5' ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label>Current password<input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><?php if($operation!=='setup'): ?><label>Authenticator or recovery code<input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code" maxlength="32" required></label><?php endif ?><button class="<?= $e($button) ?>"><?= $e($label) ?></button></form><?php endforeach; endif ?></section>
<section><h2>Active sessions</h2><p>Credential and role changes revoke all sessions. Revoking other sessions requires your current password and authenticator if enabled.</p><ul><?php foreach($sessions as $row): ?><li><?= $row['current']?'This session':'Other session' ?> · expires <?= $e(gmdate('Y-m-d H:i:s',$row['expires'])) ?> UTC<form method="post" action="/auth/account/sessions/revoke" data-account-action="/auth/account/sessions/revoke"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><input type="hidden" name="session" value="<?= $e($row['id']) ?>"><label>Current password<input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label>Authenticator or recovery code<input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code"></label><button class="<?= $e($button) ?>">Revoke session</button></form></li><?php endforeach ?></ul></section>
<?php foreach($providers as $provider): foreach(['start'=>'Link','unlink'=>'Unlink'] as $operation=>$label): ?><section><h2><?= $e($label.' '.$provider) ?></h2><form method="post" action="/auth/oauth/<?= $e($provider) ?>/<?= $e($operation) ?>" data-account-action="/auth/oauth/<?= $e($provider) ?>/<?= $e($operation) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label>Current password<input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label>Authenticator or recovery code<input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code"></label><button class="<?= $e($button) ?>"><?= $e($label.' '.$provider) ?></button></form></section><?php endforeach; endforeach ?>
<section><h2>Delete account</h2><p>This permanently removes the account and its authentication data. Application resources require your own deletion policy.</p><form method="post" action="/auth/account/delete" data-account-action="/auth/account/delete"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label>Type DELETE<input class="<?= $e($field) ?>" name="confirmation" required></label><label>Current password<input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label>Authenticator or recovery code<input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code"></label><button class="<?= $e($button) ?>">Delete account</button></form></section></main></body></html>
