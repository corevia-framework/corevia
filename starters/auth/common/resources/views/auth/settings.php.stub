<?php
$ui??=new \Corevia\Auth\AuthPresentation();$t=$ui->text(...);$title=$t('Account settings');$boot=$stack==='bootstrap';$field=$boot?'form-control':'w-full rounded-lg';$button=$boot?'btn btn-primary':'rounded-lg';
?>
<?= $__render('auth.header',compact('ui','title','stack')) ?>
<div class="auth-settings"><h1><?= $e($title) ?></h1><p><a href="/dashboard"><?= $e($t('Back to dashboard')) ?></a> &middot; <bdi><?= $e($user['email']) ?></bdi></p>
<p id="auth-feedback" role="status" data-account-notice tabindex="-1" aria-live="polite" aria-atomic="true"></p><pre data-account-output></pre>
<?php foreach(['profile'=>'Name','email'=>'Email','password'=>'Password'] as $operation=>$label): ?>
<section><h2><?= $e($t('Change '.strtolower($label))) ?></h2><form method="post" action="/auth/account/<?= $e($operation) ?>" data-account-action="/auth/account/<?= $e($operation) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>">
<?php $name=match($operation){'profile'=>'name','email'=>'email',default=>'password'}; ?><label><?= $e($t($label)) ?><input class="<?= $e($field) ?>" name="<?= $e($name) ?>" type="<?= $operation==='email'?'email':($operation==='password'?'password':'text') ?>" <?= $operation==='password'?'autocomplete="new-password" minlength="12"':($operation==='profile'?'autocomplete="name" maxlength="80"':'autocomplete="email" maxlength="254"') ?> required></label>
<?php if($operation==='password'): ?><label><?= $e($t('Confirm new password')) ?><input class="<?= $e($field) ?>" type="password" name="password_confirmation" autocomplete="new-password" required></label><?php endif ?>
<label><?= $e($t('Current password')) ?><input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code" maxlength="32"></label><button class="<?= $e($button) ?>"><?= $e($t('Save '.strtolower($label))) ?></button></form></section>
<?php endforeach ?>
<section><h2><?= $e($t('Authenticator')) ?></h2><p><?= $e($t($mfaAvailable?($mfaEnabled?'Enabled. Each code can be used once.':'Not enabled. Setup needs an authenticator app.'):'Authenticator setup is currently unavailable. Contact your administrator.')) ?></p>
<?php if($mfaAvailable): foreach(['setup'=>'Start authenticator setup','enable'=>'Confirm authenticator setup','disable'=>'Disable authenticator'] as $operation=>$label): ?><form method="post" action="/auth/mfa/<?= $e($operation) ?>" data-account-action="/auth/mfa/<?= $e($operation) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label><?= $e($t('Current password')) ?><input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><?php if($operation!=='setup'): ?><label><?= $e($t('Authenticator or recovery code')) ?><input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code" maxlength="32" required></label><?php endif ?><button class="<?= $e($button) ?>"><?= $e($t($label)) ?></button></form><?php endforeach; endif ?></section>
<?php if($passkeysAvailable??false): ?><section><h2><?= $e($t('Passkeys')) ?></h2>
<?php if(($passkeys??[])===[]): ?><p><?= $e($t('No passkeys enrolled.')) ?></p><?php endif ?>
<ul><?php foreach($passkeys??[] as $key): ?><li><strong><?= $e($key['label']) ?></strong><form method="post" action="/auth/passkeys/remove" data-account-action="/auth/passkeys/remove"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><input type="hidden" name="id" value="<?= $e($key['id']) ?>"><label><?= $e($t('Current password')) ?><input type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input name="code" autocomplete="one-time-code" maxlength="32"></label><button><?= $e($t('Remove passkey')) ?></button></form></li><?php endforeach ?></ul>
<form data-passkey-enroll hidden><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label><?= $e($t('Device label')) ?><input name="label" maxlength="120" required></label><label><?= $e($t('Current password')) ?><input type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input name="code" autocomplete="one-time-code" maxlength="32"></label><button><?= $e($t('Add passkey')) ?></button></form></section><?php endif ?>
<section><h2><?= $e($t('Active sessions')) ?></h2><p><?= $e($t('Credential and role changes revoke all sessions. Revoking other sessions requires your current password and authenticator if enabled.')) ?></p><ul><?php foreach($sessions as $row): ?><li><?= $e($t($row['current']?'This session':'Other session')) ?> &middot; <?= $e($t('Expires :time UTC',['time'=>gmdate('Y-m-d H:i:s',$row['expires'])])) ?><form method="post" action="/auth/account/sessions/revoke" data-account-action="/auth/account/sessions/revoke"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><input type="hidden" name="session" value="<?= $e($row['id']) ?>"><label><?= $e($t('Current password')) ?><input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code" maxlength="32"></label><button class="<?= $e($button) ?>"><?= $e($t('Revoke session')) ?></button></form></li><?php endforeach ?></ul></section>
<?php foreach($providers as $provider): foreach(['start'=>'Link','unlink'=>'Unlink'] as $operation=>$label): ?><section><h2><?= $e($t($label.' :provider',['provider'=>$provider])) ?></h2><form method="post" action="/auth/oauth/<?= $e($provider) ?>/<?= $e($operation) ?>" data-account-action="/auth/oauth/<?= $e($provider) ?>/<?= $e($operation) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label><?= $e($t('Current password')) ?><input class="<?= $e($field) ?>" type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input class="<?= $e($field) ?>" name="code" autocomplete="one-time-code"></label><button class="<?= $e($button) ?>"><?= $e($t($label.' :provider',['provider'=>$provider])) ?></button></form></section><?php endforeach; endforeach ?>
<?php if($lifecycleAvailable??false): ?><section><h2><?= $e($t('Export account data')) ?></h2><form method="post" action="/auth/account/export" data-account-export><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label><?= $e($t('Current password')) ?><input type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input name="code" autocomplete="one-time-code"></label><button><?= $e($t('Export account data')) ?></button></form></section><?php endif ?>
<section><h2><?= $e($t('Delete account')) ?></h2><p><?= $e($t(($lifecycleAvailable??false)?'Account erasure is processed through the registered application data policies.':'This permanently removes the account and its authentication data. Application resources require your own deletion policy.')) ?></p><form method="post" action="/auth/account/delete" data-account-action="/auth/account/delete"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label><?= $e($t('Type DELETE')) ?><input name="confirmation" required></label><label><?= $e($t('Current password')) ?><input type="password" name="current_password" autocomplete="current-password" required></label><label><?= $e($t('Authenticator or recovery code')) ?><input name="code" autocomplete="one-time-code"></label><button><?= $e($t('Delete account')) ?></button></form></section></div>
<?= $__render('auth.footer',compact('ui')) ?>
