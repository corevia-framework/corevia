<?php
$ui??=new \Corevia\Auth\AuthPresentation();$t=$ui->text(...);$bootstrap=$stack==='bootstrap';
$field=$bootstrap?'form-control':'w-full rounded-lg';$button=$bootstrap?'btn btn-primary w-100':'w-full rounded-lg';$spacing=$bootstrap?'mb-3':'mb-5';
$title=$t($page==='dashboard'?'Your workspace':($page==='register'?'Create account':'Sign in'));
?>
<?= $__render('auth.header',compact('ui','title','stack')) ?>
<div class="<?= $page==='dashboard'?'auth-settings':'auth-layout' ?>">
<?php if($page!=='dashboard'): ?><aside class="auth-story"><p>COREVIA / V4</p><h2><?= $e($t('Your next chapter starts here.')) ?></h2><p><?= $e($t('A space for your work, your ideas and the people you build for.')) ?></p></aside><?php endif ?>
<section class="auth-surface"><p class="auth-eyebrow">COREVIA / <?= $e($t('Your workspace')) ?></p>
<h1><?= $e($page==='dashboard'?$t('Welcome, :name',['name'=>$user['name']]):$t($page==='register'?'Make it yours.':'Welcome back.')) ?></h1>
<p id="auth-feedback" data-account-notice role="status" tabindex="-1" aria-live="polite" aria-atomic="true"></p>
<?php if($error): ?><p id="auth-error" data-auth-error role="alert" tabindex="-1"><?= $e($t($error)) ?></p><?php endif ?>
<?php if($page==='dashboard'): ?>
<p><?= $e($t('You are signed in as :email.',['email'=>$user['email']])) ?></p><p><a href="/account"><?= $e($t('Account settings')) ?></a></p>
<?php if($recoveryEnabled): ?><p><?= $e($t($emailVerified?'Email verified.':'Your email is not verified yet.')) ?> <?php if(!$emailVerified): ?><a href="/verify-email"><?= $e($t('Verify email')) ?></a><?php endif ?></p><?php endif ?>
<form method="post" action="/logout"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><button class="<?= $e($button) ?>" type="submit"><?= $e($t('Sign out')) ?></button></form>
<?php else: ?>
<p class="auth-muted"><?= $e($t($page==='register'?'Create your account to open your workspace.':'Sign in to continue building.')) ?></p>
<form method="post" action="/<?= $e($page) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>">
<?php if($page==='register'): ?><div class="<?= $e($spacing) ?>"><label for="name"><?= $e($t('Your name')) ?></label><input class="<?= $e($field) ?>" id="name" name="name" autocomplete="name" maxlength="80" required></div><?php endif ?>
<div class="<?= $e($spacing) ?>"><label for="email"><?= $e($t('Email address')) ?></label><input class="<?= $e($field) ?>" id="email" name="email" type="email" autocomplete="username" maxlength="254" required <?= $error?'aria-invalid="true" aria-describedby="auth-error"':'' ?>></div>
<div class="<?= $e($spacing) ?>"><label for="password"><?= $e($t('Password')) ?></label><input class="<?= $e($field) ?>" id="password" name="password" type="password" autocomplete="<?= $page==='register'?'new-password':'current-password' ?>" <?= $page==='register'?'minlength="12" aria-describedby="password-hint"':'' ?> <?= $error?'aria-invalid="true"':'' ?> required></div>
<?php if($page==='register'): ?><div class="<?= $e($spacing) ?>"><label for="password_confirmation"><?= $e($t('Confirm password')) ?></label><input class="<?= $e($field) ?>" id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" aria-describedby="password-hint" required><small id="password-hint"><?= $e($t('At least 12 characters, at most 72 bytes.')) ?></small></div><?php endif ?>
<?php if($page==='login'): ?><div class="<?= $e($spacing) ?>"><label for="code"><?= $e($t('Authenticator or recovery code (if enabled)')) ?></label><input class="<?= $e($field) ?>" id="code" name="code" autocomplete="one-time-code" maxlength="32"></div><p><label><input type="checkbox" name="remember" value="1"> <?= $e($t('Remember me for up to 30 days')) ?></label></p><?php endif ?>
<button class="<?= $e($button) ?>" type="submit"><?= $e($t($page==='register'?'Create account':'Sign in')) ?></button></form>
<?php if($page==='login'&&($passkeysAvailable??false)): ?><p><button type="button" data-passkey-login hidden><?= $e($t('Sign in with a passkey')) ?></button></p><?php endif ?>
<?php if($page==='login'): foreach($providers??[] as $provider): ?><form method="post" action="/auth/oauth/<?= $e($provider) ?>/start" data-account-action="/auth/oauth/<?= $e($provider) ?>/start"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><button type="submit"><?= $e($t('Continue with :provider',['provider'=>$provider])) ?></button></form><?php endforeach; endif ?>
<?php if($page==='login'&&$recoveryEnabled): ?><p><a href="/forgot-password"><?= $e($t('Forgot password?')) ?></a></p><?php endif ?>
<p><?php if($page==='register'): ?><?= $e($t('Already have an account?')) ?> <a href="/login"><?= $e($t('Sign in')) ?></a><?php elseif($registration): ?><?= $e($t('New here?')) ?> <a href="/register"><?= $e($t('Create account')) ?></a><?php endif ?></p>
<?php endif ?></section></div>
<?= $__render('auth.footer',compact('ui')) ?>
