<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><?= $e($page==='dashboard'?'Your workspace':($page==='register'?'Create account':'Sign in')) ?> · Corevia</title><link rel="stylesheet" href="/assets/auth.css"></head>
<?php
$bootstrap=$stack==='bootstrap';
$body=$bootstrap?'bg-light':'bg-slate-950 text-slate-100';
$main=$bootstrap?'container py-5':'min-h-screen grid place-items-center px-6 py-16';
$card=$bootstrap?'auth-card card shadow-sm mx-auto p-4':'w-full max-w-md rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-xl';
$field=$bootstrap?'form-control':'w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-400';
$label=$bootstrap?'form-label':'mb-2 block text-sm font-medium text-slate-300';
$spacing=$bootstrap?'mb-3':'mb-5';
$button=$bootstrap?'btn btn-primary w-100':'w-full rounded-lg bg-cyan-400 px-4 py-3 font-semibold text-slate-950 hover:bg-cyan-300';
$link=$bootstrap?'link-primary':'text-cyan-300 underline underline-offset-4';
?>
<body class="<?= $e($body) ?>"><main class="<?= $e($main) ?>"><section class="<?= $e($card) ?>">
<p class="<?= $bootstrap?'text-secondary small':'mb-6 text-xs font-semibold uppercase tracking-widest text-cyan-300' ?>">COREVIA / YOUR WORKSPACE</p>
<h1 class="<?= $bootstrap?'h3 mb-3':'mb-3 text-3xl font-semibold tracking-tight' ?>"><?= $e($page==='dashboard'?'Welcome, '.$user['name']:($page==='register'?'Make it yours.':'Welcome back.')) ?></h1>
<?php if($error): ?><p role="alert" class="<?= $bootstrap?'alert alert-danger':'my-4 rounded-lg bg-red-950 p-4 text-red-200' ?>"><?= $e($error) ?></p><?php endif ?>
<?php if($page==='dashboard'): ?>
<p class="<?= $spacing ?>">You are signed in as <?= $e($user['email']) ?>.</p>
<form method="post" action="/logout"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><button class="<?= $e($button) ?>" type="submit">Sign out</button></form>
<?php else: ?>
<p class="<?= $bootstrap?'text-secondary mb-4':'mb-8 text-sm leading-6 text-slate-400' ?>"><?= $page==='register'?'Create your account to open your workspace.':'Sign in to continue building.' ?></p>
<form method="post" action="/<?= $e($page) ?>"><input type="hidden" name="_token" value="<?= $e($csrf) ?>">
<?php if($page==='register'): ?><div class="<?= $e($spacing) ?>"><label class="<?= $e($label) ?>" for="name">Your name</label><input class="<?= $e($field) ?>" id="name" name="name" autocomplete="name" maxlength="80" required></div><?php endif ?>
<div class="<?= $e($spacing) ?>"><label class="<?= $e($label) ?>" for="email">Email address</label><input class="<?= $e($field) ?>" id="email" name="email" type="email" autocomplete="username" maxlength="254" required></div>
<div class="<?= $e($spacing) ?>"><label class="<?= $e($label) ?>" for="password">Password</label><input class="<?= $e($field) ?>" id="password" name="password" type="password" autocomplete="<?= $page==='register'?'new-password':'current-password' ?>" <?= $page==='register'?'minlength="12"':'' ?> required></div>
<?php if($page==='register'): ?><div class="<?= $e($spacing) ?>"><label class="<?= $e($label) ?>" for="password_confirmation">Confirm password</label><input class="<?= $e($field) ?>" id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required><small>At least 12 characters, at most 72 bytes.</small></div><?php endif ?>
<button class="<?= $e($button) ?>" type="submit"><?= $page==='register'?'Create account':'Sign in' ?></button></form>
<p class="<?= $bootstrap?'mt-4 mb-0':'mt-6 text-sm text-slate-400' ?>"><?php if($page==='register'): ?>Already have an account? <a class="<?= $e($link) ?>" href="/login">Sign in</a><?php elseif($registration): ?>New here? <a class="<?= $e($link) ?>" href="/register">Create an account</a><?php endif ?></p>
<?php endif ?></section></main></body></html>
