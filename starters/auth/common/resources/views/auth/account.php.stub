<?php
$ui??=new \Corevia\Auth\AuthPresentation();$t=$ui->text(...);$bootstrap=$stack==='bootstrap';$field=$bootstrap?'form-control':'w-full rounded-lg';$button=$bootstrap?'btn btn-primary w-100':'w-full rounded-lg';
$title=$t(match($page){'forgot-password'=>'Forgot your password?','reset-password'=>'Choose a new password.',default=>'Verify your email.'});
?>
<?= $__render('auth.header',compact('ui','title','stack')) ?>
<div class="auth-layout"><aside class="auth-story"><p>COREVIA / V4</p><h2><?= $e($t('Your next chapter starts here.')) ?></h2><p><?= $e($t('A space for your work, your ideas and the people you build for.')) ?></p></aside><section class="auth-surface">
<p class="auth-eyebrow">COREVIA / <?= $e($t('Account settings')) ?></p><h1><?= $e($title) ?></h1><p id="auth-feedback" role="status" data-account-notice tabindex="-1" aria-live="polite" aria-atomic="true"><?= $e($t($notice??'')) ?></p>
<?php if($page==='forgot-password'): ?>
<p><?= $e($t('Enter your email to request a recovery link.')) ?></p><form method="post" action="/forgot-password"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><label for="email"><?= $e($t('Email address')) ?></label><input class="<?= $field ?>" id="email" name="email" type="email" autocomplete="email" maxlength="254" required><button class="<?= $button ?>"><?= $e($t('Send recovery link')) ?></button></form>
<?php elseif($page==='reset-password'): ?>
<form method="post" action="/auth/password/reset" data-account-action="/auth/password/reset"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><input type="hidden" name="token" value=""><label for="password"><?= $e($t('New password')) ?></label><input class="<?= $field ?>" id="password" name="password" type="password" autocomplete="new-password" minlength="12" required><label for="password_confirmation"><?= $e($t('Confirm password')) ?></label><input class="<?= $field ?>" id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required><button class="<?= $button ?>"><?= $e($t('Update password')) ?></button></form><noscript><?= $e($t('Enable JavaScript to open this link.')) ?></noscript>
<?php elseif(!$user): ?><p><?= $e($t('Sign in to the account that requested this link, then open the link again.')) ?></p>
<?php elseif($verified): ?><p><?= $e($t('Your email is verified. Your workspace is ready.')) ?></p><a href="/dashboard"><?= $e($t('Open dashboard')) ?></a>
<?php else: ?>
<p><?= $e($t('Confirm the link from your email, or request a new one.')) ?></p><form method="post" action="/auth/email/verify" data-account-action="/auth/email/verify"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><input type="hidden" name="token" value=""><button class="<?= $button ?>"><?= $e($t('Confirm email')) ?></button></form><form method="post" action="/auth/email/resend" data-account-action="/auth/email/resend"><input type="hidden" name="_token" value="<?= $e($csrf) ?>"><button class="<?= $button ?>"><?= $e($t('Send verification link')) ?></button></form>
<?php endif ?><p><a href="/login"><?= $e($t('Back to sign in')) ?></a></p></section></div>
<?= $__render('auth.footer',compact('ui')) ?>
