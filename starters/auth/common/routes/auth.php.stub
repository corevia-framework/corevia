<?php
declare(strict_types=1);
use Corevia\Auth\{AccountDelivery,AccountManager,AccountRecovery,AccountStore,AuthRoutes,AuthService,AuthStore,Gate,IdentityStore,JsonAuthStore,MailQueue,MfaService,OAuthService,PreviewDelivery,SecretBox,SqlAuthStore};
use Corevia\Core\Corevia;
use Corevia\Http\{Router,View};
use Corevia\Persistence\DatabaseManager;
return static function(Router $router,Corevia $app):void{
    $settings=require $app->basePath.'/config/auth.php';
    $app->config->set('auth',$settings);
    $store=match($settings['driver']){'json'=>new JsonAuthStore($settings['store']),'sql'=>new SqlAuthStore($app->container->get(DatabaseManager::class)->sql($settings['connection']),$settings['prefix']),default=>throw new InvalidArgumentException('Choose json or sql auth storage.')};
    $box=($settings['mfa'] || $settings['oauth']!==[])?SecretBox::fromFile($settings['key_file']):null;
    $mfa=$settings['mfa']?new MfaService($store,$box):null;
    $auth=new AuthService($store,$settings['url'],$settings['registration'],mfa:$mfa,rememberTtl:$settings['remember_ttl']);
    $manager=new AccountManager($store,$auth);$gate=new Gate($store,$settings['roles']);$providers=array_map(static fn(string $class)=>$app->container->get($class),$settings['oauth']);$oauth=$providers!==[]?new OAuthService($store,$box,$auth,$providers):null;
    $app->container->set(IdentityStore::class,$store);$app->container->set(AccountManager::class,$manager);$app->container->set(Gate::class,$gate);
    if($mfa!==null){$app->container->set(MfaService::class,$mfa);$app->capabilities->define('auth.mfa');}if($oauth!==null){$app->container->set(OAuthService::class,$oauth);$app->capabilities->define('auth.oauth');}
    $app->container->set(AuthStore::class,$store);$app->container->set(AuthService::class,$auth);
    $app->container->set(AccountStore::class,$store);
    $app->capabilities->define('auth.session',metadata:['store'=>$store::class,'csrf'=>'session-bound']);
    $accounts=null;
    if($settings['delivery']!=='disabled'){
        $delivery=match($settings['delivery']){'preview'=>new PreviewDelivery($settings['outbox']),'smtp'=>MailQueue::configured($settings),default=>$app->container->get($settings['delivery'])};
        if(!$delivery instanceof AccountDelivery){throw new LogicException('Delivery must implement AccountDelivery.');}
        $accounts=new AccountRecovery($store,$delivery,$auth,$app->logger);$app->container->set(AccountDelivery::class,$delivery);$app->container->set(AccountRecovery::class,$accounts);$app->capabilities->define('auth.recovery');
    }
    AuthRoutes::mount($router,$app->container->get(View::class),$auth,$settings['stack'],$accounts,$settings['require_verified'],$manager,$mfa,$gate,$oauth);
};
