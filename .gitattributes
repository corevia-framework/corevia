**/node_modules export-ignore
**/__pycache__ export-ignore
**/.dart_tool export-ignore
**/.pytest_cache export-ignore
**/.phpunit.cache export-ignore
/storage/* export-ignore
/storage/.gitkeep -export-ignore
/test-project/storage/* export-ignore
/test-project/storage/.gitkeep -export-ignore
/build export-ignore
/dist export-ignore
/coverage export-ignore
**/.env export-ignore
**/.env.* export-ignore
