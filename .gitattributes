* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
/starters/auth/assets/** -text

# Repository automation is useful to contributors, not installed applications.
/.github export-ignore

# Defense in depth for local notes if archiving an older checkout.
/CODEX.md export-ignore
/docs/implementation.md export-ignore
/docs/validation.md export-ignore
/docs/v2/phases.md export-ignore
/docs/v2/release.md export-ignore

# GitHub/Packagist dist archives must not contain local state or credentials.
/.git export-ignore
/.codex export-ignore
/.agents export-ignore
/.claude export-ignore
/.idea export-ignore
/.vscode export-ignore
/.aws export-ignore
/.azure export-ignore
/.gcloud export-ignore
