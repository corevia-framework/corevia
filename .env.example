# Documentation template only. Read these explicitly via your process environment.
APP_ENV=development
APP_HTTPS=false
APP_URL=http://127.0.0.1:8081
AUTH_REGISTRATION=true
DB_CONNECTION=local
DB_HOST=127.0.0.1
# DB_PORT=3306                 # PostgreSQL: 5432
DB_DATABASE=corevia
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# SQLITE_DATABASE=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=corevia
RUN_STORE=json
# RUN_DB_CONNECTION=mysql
# Optional private storage directory. Default: ./storage
# COREVIA_STORAGE=
# The checkout sample uses SQLite; test-project requires no database extension.
# Set tokens in your environment; do not commit local .env files.
