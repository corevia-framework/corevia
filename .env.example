# Documentation template only. Read these explicitly via your process environment.
APP_ENV=development
APP_HTTPS=false
APP_URL=http://127.0.0.1:8081
AUTH_REGISTRATION=true
# Auth starter defaults to JSON and a private local preview mailbox.
AUTH_STORE=json
# AUTH_CONNECTION=sqlite
# AUTH_TABLE_PREFIX=cv_auth
# AUTH_DELIVERY=preview       # Production: smtp, an AccountDelivery class, or disabled
AUTH_REQUIRE_VERIFIED_EMAIL=false
# AUTH_MFA=true               # Enabled when OpenSSL is available; existing MFA fails closed without it
# AUTH_KEY_FILE=              # Provisioned 32-byte shared key; do not rotate independently of data
# AUTH_SHARED_KEY_PROVISIONED=false
# AUTH_GITHUB=false
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE=false
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MONGODB_URI=mongodb://127.0.0.1:27017
# AUTH_MONGODB_DATABASE=corevia
# AUTH_SCOPE=main
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls     # Or smtps, usually port 465; plaintext is unsupported
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=accounts@example.com
# SMTP_CA_FILE=               # Optional CA bundle; peer/hostname verification stays enabled
# AUTH_DELIVERY=sqlsmtp       # Shared encrypted SMTP queue; run mail:migrate before using
# MAIL_CONNECTION=mysql
# MAIL_TABLE_PREFIX=cv_mail
# QUEUE_CONNECTION=mysql
# QUEUE_TABLE_PREFIX=cv_work
# AI_ENABLED=false
# AI_BASE_URL=http://127.0.0.1:8111/v1
# AI_MODEL=local
# AI_LOCAL=true              # Explicit permission for literal loopback HTTP only
# AI_API_KEY=                # Server-side provider/worker credential, never frontend code
# AI_TOKEN_FIELD=max_tokens  # Or max_completion_tokens for compatible providers requiring it
# MODEL_WORKER_TOKEN=        # At least 32 random characters, for the local Python host
DB_CONNECTION=local
DB_HOST=127.0.0.1
# DB_PORT=3306                 # PostgreSQL: 5432
DB_DATABASE=corevia
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# SQLITE_DATABASE=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=corevia
RUN_STORE=json
# RUN_DB_CONNECTION=mysql
# Optional private storage directory. Default: ./storage
# COREVIA_STORAGE=
# The checkout sample uses SQLite; test-project requires no database extension.
# Set tokens in your environment; do not commit local .env files.
