# Review for the selected Elastic Beanstalk PHP platform branch.
# Copy to .ebextensions/corevia.config in the deployment ZIP root.
# EC2 can instead use the VPS recipe after target validation.
option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    display_errors: "Off"
    max_execution_time: 60
    memory_limit: 128M
# Upload vendor and prebuilt assets; review platform Composer behavior.
# Configure private persistent/shared storage, HTTPS-only load balancer policy,
# security groups and application environment separately. No worker tier implied.
